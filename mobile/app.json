{
  "expo": {
    "name": "Mizu Member",
    "slug": "mizu-member",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/mizu-icon.png",
    "scheme": "mizumember",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/mizu-icon.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#2D211A",
        "foregroundImage": "./assets/images/mizu-icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.mizufamily.member"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/mizu-favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#fffaf2",
          "image": "./assets/images/mizu-wordmark.png",
          "imageWidth": 200
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "0c194cd0-e934-48af-95f2-7818cdd9e6dd"
      }
    }
  }
}
